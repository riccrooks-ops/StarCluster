      "id": "a11-c01",
      "name": "Kinetic hit spends one Tactical Power and one ammunition package",
      "operation": "weaponFire",
      "input": {
        "weapon": "kinetic",
        "mode": "standard",
        "hit": true,
        "envelope": {
          "$baseline": "reactor_output"
        },
        "startingAmmunition": {
          "$baseline": "kinetic_ammo"
        },
        "defense": {
          "currentShieldCapacity": 6,
          "shieldArmor": 0,
          "currentHull": {
            "$baseline": "hull_points"
          },
          "temporaryShieldOvercapacity": 0
        }
      },
      "expected": {
        "fire": {
          "hit": true,
          "tacticalPowerSpent": {
            "$baseline": "kinetic_power"
          },
          "ammunitionSpent": {
            "$baseline": "ammunition_ready_package"
          },
          "remainingAmmunition": {
            "$subtract": [
              {
                "$input": "$.startingAmmunition"
              },
              {
                "$actual": "$.fire.ammunitionSpent"
              }
            ]
          },
          "power": {
            "available": {
              "$subtract": [
                {
                  "$baseline": "reactor_output"
                },
                {
                  "$baseline": "kinetic_power"
                }
              ]
            },
            "spent": {
              "$baseline": "kinetic_power"
            }
          },
          "damageResolution": {
            "incomingDamage": {
              "$baseline": "kinetic_damage"
            },
            "shieldBypass": {
              "$baseline": "kinetic_spen"
            },
            "shieldAbsorption": {
              "$min": [
                {
                  "$input": "$.defense.currentShieldCapacity"
                },
                {
                  "$max": [
                    0,
                    {
                      "$subtract": [
                        {
                          "$baseline": "kinetic_damage"
                        },
                        {
                          "$baseline": "kinetic_spen"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "defense": {
          "currentShieldCapacity": {
            "$subtract": [
              {
                "$input": "$.defense.currentShieldCapacity"
              },
              {
                "$min": [
                  {
                    "$input": "$.defense.currentShieldCapacity"
                  },
                  {
                    "$max": [
                      0,
                      {
                        "$subtract": [
                          {
                            "$baseline": "kinetic_damage"
                          },
                          {
                            "$baseline": "kinetic_spen"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "temporaryShieldOvercapacity": {
            "$input": "$.defense.temporaryShieldOvercapacity"
          },
          "armorLayers": [
            {
              "id": "armor-1",
              "currentProtection": {
                "$baseline": "armor_protection"
              },
              "currentIntegrity": {
                "$subtract": [
                  {
                    "$baseline": "armor_integrity"
                  },
                  {
                    "$actual": "$.fire.damageResolution.armorLayers[0].integrityDamage"
                  }
                ]
              }
            }
          ],
          "currentHull": {
            "$input": "$.defense.currentHull"
          }
        }
      }
    },
