{
  "schemaVersion": "star-cluster-tl1-phase-a-v1",
  "id": "tl1-a03-turn-start-shield-recharge",
  "matrixScenarioId": "TL1-A03",
  "name": "Turn-start Shield recharge and power spending",
  "baselineVersion": "tl1-core-combat-v0.1",
  "baselineSha256": "cff1b6caca7eb4d32d08a140fba3c645d98c1275ef13b4185f830dccfbd49d19",
  "cases": [
    {
      "id": "a03-c01",
      "name": "Operational shield receives base and requested tactical recharge",
      "operation": "turnStartRecharge",
      "input": {
        "defense": {
          "pristineShieldCapacity": 6,
          "currentShieldCapacity": 2,
          "shieldArmor": 0,
          "currentHull": {
            "$baseline": "hull_points"
          },
          "temporaryShieldOvercapacity": 0,
          "armorLayers": [
            {
              "id": "armor-1",
              "pristineProtection": 2,
              "currentProtection": 2,
              "pristineIntegrity": 6,
              "currentIntegrity": 6
            }
          ]
        },
        "shieldCondition": "operational",
        "reactorCondition": "operational",
        "requestedTacticalRechargePower": {
          "$baseline": "shield_tactical_recharge_cap"
        }
      },
      "expected": {
        "baseRestored": {
          "$baseline": "shield_base_recharge"
        },
        "tacticalPowerSpent": {
          "$baseline": "shield_tactical_recharge_cap"
        },
        "tacticalRestored": {
          "$multiply": [
            {
              "$baseline": "shield_tactical_recharge_cap"
            },
            {
              "$baseline": "shield_tactical_recharge_rate"
            }
          ]
        },
        "defense": {
          "currentShieldCapacity": {
            "$add": [
              {
                "$input": "$.defense.currentShieldCapacity"
              },
              {
                "$baseline": "shield_base_recharge"
              },
              {
                "$multiply": [
                  {
                    "$baseline": "shield_tactical_recharge_cap"
                  },
                  {
                    "$baseline": "shield_tactical_recharge_rate"
                  }
                ]
              }
            ]
          }
        },
        "power": {
          "envelope": {
            "$baseline": "reactor_output"
          },
          "available": {
            "$subtract": [
              {
                "$baseline": "reactor_output"
              },
              {
                "$baseline": "shield_tactical_recharge_cap"
              }
            ]
          },
          "spent": {
            "$baseline": "shield_tactical_recharge_cap"
          }
        }
      }
    },
    {
