{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "star-cluster-ai-doctrine-registry-schema-v0-2",
  "type": "object",
  "required": [
    "schemaVersion",
    "registryVersion",
    "dependencies",
    "doctrines",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "star-cluster-ai-doctrine-registry-v1"
    },
    "registryVersion": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "doctrines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "domain",
          "status",
          "ecmHeuristic",
          "eccmHeuristic",
          "dependencies",
          "rationale",
          "informationPolicy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "domain": {
            "const": "electronic-warfare"
          },
          "status": {
            "enum": [
              "control",
              "experimental",
              "accepted",
              "superseded",
              "rejected"
            ]
          },
          "ecmHeuristic": {
            "enum": [
              "Never",
              "AlwaysNormal",
              "PreserveOffenseAndEccm",
              "PreserveCombatPackageAndEccm"
            ]
          },
          "eccmHeuristic": {
            "enum": [
              "Never",
              "ReactiveOnFirmDegradation"
            ]
          },
          "acceptedCheckpoint": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "informationPolicy": {
            "type": "object",
            "required": [
              "usesOwnCapabilities",
              "usesObservedTrackState",
              "usesObservedEnemyEmissions",
              "usesHiddenEnemyRatings"
            ],
            "properties": {
              "usesOwnCapabilities": {
                "type": "boolean"
              },
              "usesObservedTrackState": {
                "type": "boolean"
              },
              "usesObservedEnemyEmissions": {
                "type": "boolean"
              },
              "usesHiddenEnemyRatings": {
                "const": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "checkpoint",
          "studyId",
          "status",
          "resultSha256",
          "conclusion",
          "dependencyIds",
          "revalidateIfChanged"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "checkpoint": {
            "type": "string",
            "minLength": 1
          },
          "studyId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "accepted",
              "diagnostic",
              "rejected"
            ]
          },
          "resultSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "conclusion": {
            "type": "string",
            "minLength": 1
          },
          "keyMetrics": {
            "type": "object"
          },
          "dependencyIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "revalidateIfChanged": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
