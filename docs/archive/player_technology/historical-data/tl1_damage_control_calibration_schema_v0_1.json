{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starcluster.local/schemas/tl1_damage_control_calibration_schema_v0_1.json",
  "title": "Star Cluster TL1 Damage Control Doctrine Calibration Study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "baselineSha256",
    "masterSeed",
    "trialsPerVariant",
    "variants"
  ],
  "properties": {
    "schemaVersion": {
      "const": "star-cluster-tl1-damage-control-calibration-v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "baselineSha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "masterSeed": {
      "type": "integer",
      "minimum": 0
    },
    "trialsPerVariant": {
      "type": "integer",
      "minimum": 1
    },
    "variants": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "density",
          "protectedCompartmentation",
          "doctrine",
          "loadout",
          "damageTempo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "density": {
            "enum": ["Percent25", "Percent33"]
          },
          "protectedCompartmentation": {
            "type": "boolean"
          },
          "doctrine": {
            "enum": [
              "None",
              "ComponentOnly",
              "HullHalf",
              "HullHalfReserveOne"
            ]
          },
          "loadout": {
            "enum": ["kinetic", "missile"]
          },
          "damageTempo": {
            "enum": ["steady", "burst"]
          }
        }
      }
    }
  }
}
