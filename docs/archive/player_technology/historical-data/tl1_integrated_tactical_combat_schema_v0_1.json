{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "star-cluster-tl1-integrated-tactical-combat-schema-v0-1",
  "title": "Star Cluster TL1 Integrated Tactical Combat Study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "baselineSha256",
    "masterSeed",
    "trialsPerVariant",
    "variants"
  ],
  "properties": {
    "schemaVersion": {
      "const": "star-cluster-tl1-integrated-tactical-combat-v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "baselineSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "masterSeed": {
      "type": "integer",
      "minimum": 0
    },
    "trialsPerVariant": {
      "type": "integer",
      "minimum": 1
    },
    "variants": {
      "type": "array",
      "minItems": 90,
      "maxItems": 90,
      "items": {
        "$ref": "#/$defs/variant"
      }
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sideAFamily",
        "sideBFamily",
        "movementMode",
        "protectedCompartmentation",
        "damageControl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sideAFamily": {
          "enum": [
            "Kinetic",
            "Energy",
            "Missile"
          ]
        },
        "sideBFamily": {
          "enum": [
            "Kinetic",
            "Energy",
            "Missile"
          ]
        },
        "movementMode": {
          "enum": [
            "HoldRange2",
            "HoldRange4",
            "ScriptedPursuit",
            "PreferredRange"
          ]
        },
        "protectedCompartmentation": {
          "type": "boolean"
        },
        "damageControl": {
          "enum": [
            "None",
            "ComponentFirstReserveOne"
          ]
        }
      }
    }
  }
}
