{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "star-cluster-tl1-combat-pacing-v1",
  "title": "Star Cluster TL1 Combat Pacing Study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "baselineSha256",
    "masterSeed",
    "trialsPerVariant",
    "variants"
  ],
  "properties": {
    "schemaVersion": {
      "const": "star-cluster-tl1-combat-pacing-v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "baselineSha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "masterSeed": {
      "type": "integer",
      "minimum": 0
    },
    "trialsPerVariant": {
      "type": "integer",
      "minimum": 1
    },
    "variants": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "density",
          "protectedCompartmentation",
          "damageControl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "density": {
            "enum": [
              "Percent25",
              "Percent33"
            ]
          },
          "protectedCompartmentation": {
            "type": "boolean"
          },
          "damageControl": {
            "enum": [
              "None",
              "ComponentFirstReserveOne"
            ]
          }
        }
      }
    }
  }
}
