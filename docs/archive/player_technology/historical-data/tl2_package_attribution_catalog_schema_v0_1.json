{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "star-cluster-tl2-package-attribution-catalog-v1",
  "title": "Star Cluster TL2 package attribution catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "checkpoint",
    "status",
    "baselineSha256",
    "sourceCandidateCatalog",
    "sourceCheckpointResults",
    "targetHigherTlWinPercent",
    "reviewBandMinimumPercent",
    "reviewBandMaximumPercent",
    "promotionPolicy",
    "retainedExternalControls",
    "attributionGroups",
    "movementAwareProfileIds",
    "sameTlProfileIds",
    "mirrorCalibrationEvidence",
    "crossFamilyCalibrationEvidence",
    "aggressiveControlThresholdPercent",
    "ranges",
    "tierModel",
    "identityGuardrails",
    "tl1AnalyticalAssumptions",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "star-cluster-tl2-package-attribution-catalog-v1"
    },
    "id": {
      "const": "tl2-package-attribution-and-refinement-v0_1"
    },
    "checkpoint": {
      "const": 44
    },
    "status": {
      "const": "diagnostic_candidate_only"
    },
    "baselineSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceCandidateCatalog": {
      "type": "string",
      "minLength": 1
    },
    "sourceCheckpointResults": {
      "type": "string",
      "minLength": 1
    },
    "targetHigherTlWinPercent": {
      "const": 60
    },
    "reviewBandMinimumPercent": {
      "const": 57
    },
    "reviewBandMaximumPercent": {
      "const": 64
    },
    "promotionPolicy": {
      "type": "string",
      "minLength": 20
    },
    "retainedExternalControls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "attributionGroups": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "changedFields",
          "additiveProfileId",
          "leaveOneOutProfileId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "changedFields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "additiveProfileId": {
            "type": "string"
          },
          "leaveOneOutProfileId": {
            "type": "string"
          }
        }
      }
    },
    "movementAwareProfileIds": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "sameTlProfileIds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "mirrorCalibrationEvidence": {
      "type": "string"
    },
    "crossFamilyCalibrationEvidence": {
      "type": "string"
    },
    "aggressiveControlThresholdPercent": {
      "type": "number"
    },
    "ranges": {
      "const": [
        2,
        3,
        4,
        5
      ]
    },
    "tierModel": {
      "type": "object"
    },
    "identityGuardrails": {
      "type": "object"
    },
    "tl1AnalyticalAssumptions": {
      "type": "object"
    },
    "candidates": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "weapon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "damage",
        "shieldPenetration",
        "armorPenetration",
        "accuracyBonus",
        "guidanceChance",
        "maximumRange",
        "powerCost",
        "ammunition"
      ],
      "properties": {
        "damage": {
          "type": "integer",
          "minimum": 0
        },
        "shieldPenetration": {
          "type": "integer",
          "minimum": 0
        },
        "armorPenetration": {
          "type": "integer",
          "minimum": 0
        },
        "accuracyBonus": {
          "type": "integer",
          "minimum": 0
        },
        "guidanceChance": {
          "type": "integer",
          "minimum": 0
        },
        "maximumRange": {
          "type": "integer",
          "minimum": 1
        },
        "powerCost": {
          "type": "integer",
          "minimum": 0
        },
        "ammunition": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "status",
        "analysisRole",
        "designThesis",
        "componentNames",
        "defense",
        "powerAndControl",
        "movement",
        "weapons",
        "referenceInfluences",
        "namingReview"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tl2-"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "pattern": "not-promoted$"
        },
        "analysisRole": {
          "enum": [
            "null_control",
            "additive_probe",
            "leave_one_out_probe",
            "identity_source_control",
            "refinement_probe"
          ]
        },
        "attributionGroup": {
          "type": "string"
        },
        "designThesis": {
          "type": "string",
          "minLength": 20
        },
        "componentNames": {
          "type": "object"
        },
        "defense": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hull",
            "armorIntegrity",
            "armorProtection",
            "shieldCapacity",
            "shieldBaseRecharge",
            "shieldArmor"
          ],
          "properties": {
            "hull": {
              "type": "integer",
              "minimum": 0
            },
            "armorIntegrity": {
              "type": "integer",
              "minimum": 0
            },
            "armorProtection": {
              "type": "integer",
              "minimum": 0
            },
            "shieldCapacity": {
              "type": "integer",
              "minimum": 0
            },
            "shieldBaseRecharge": {
              "type": "integer",
              "minimum": 0
            },
            "shieldArmor": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "powerAndControl": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reactorOutput",
            "targetingBonus",
            "effectivePdsChance",
            "pdsPower",
            "standardCombatPowerCommitment"
          ],
          "properties": {
            "reactorOutput": {
              "type": "integer",
              "minimum": 0
            },
            "targetingBonus": {
              "type": "integer",
              "minimum": 0
            },
            "effectivePdsChance": {
              "type": "integer",
              "minimum": 0
            },
            "pdsPower": {
              "type": "integer",
              "minimum": 0
            },
            "standardCombatPowerCommitment": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "movement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shipMove",
            "missileMove"
          ],
          "properties": {
            "shipMove": {
              "type": "integer",
              "minimum": 1
            },
            "missileMove": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "weapons": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kinetic",
            "energy",
            "missile"
          ],
          "properties": {
            "kinetic": {
              "$ref": "#/$defs/weapon"
            },
            "energy": {
              "$ref": "#/$defs/weapon"
            },
            "missile": {
              "$ref": "#/$defs/weapon"
            }
          }
        },
        "referenceInfluences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "namingReview": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
