{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "star-cluster-tl1-defensive-calibration-v1",
  "title": "Star Cluster TL1 Layered Defensive Systems Calibration Study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "baselineSha256",
    "masterSeed",
    "trialsPerVariant",
    "variants"
  ],
  "properties": {
    "schemaVersion": {
      "const": "star-cluster-tl1-defensive-calibration-v1"
    },
    "id": { "type": "string", "minLength": 1 },
    "baselineSha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "masterSeed": { "type": "integer", "minimum": 0 },
    "trialsPerVariant": { "type": "integer", "minimum": 1 },
    "variants": {
      "type": "array",
      "minItems": 171,
      "maxItems": 171,
      "items": { "$ref": "#/$defs/variant" }
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "category",
        "pairId",
        "shieldCapacity",
        "shieldArmor",
        "baseShieldRecharge",
        "armorProtection",
        "armorIntegrity",
        "hull",
        "rangeHexes",
        "rangePenaltyPerHex",
        "turnCap",
        "sideA",
        "sideB"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "accepted-control",
            "pds-rule-correction",
            "sensor-ew-boundary",
            "shield-defense",
            "layered-defense"
          ]
        },
        "pairId": { "type": ["string", "null"] },
        "shieldCapacity": { "type": "integer", "minimum": 0 },
        "shieldArmor": { "type": "integer", "minimum": 0 },
        "baseShieldRecharge": { "type": "integer", "minimum": 0 },
        "armorProtection": { "type": "integer", "minimum": 0 },
        "armorIntegrity": { "type": "integer", "minimum": 0 },
        "hull": { "type": "integer", "minimum": 1 },
        "rangeHexes": { "type": "integer", "minimum": 0 },
        "rangePenaltyPerHex": { "type": "integer", "minimum": 0 },
        "turnCap": { "type": "integer", "minimum": 1 },
        "sideA": { "$ref": "#/$defs/side" },
        "sideB": { "$ref": "#/$defs/side" }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "doctrine",
        "accuracy",
        "computerBonus",
        "evasive",
        "reactorOutput",
        "ammunition",
        "missileGuidance",
        "missileDamage",
        "missileShieldPenetration",
        "missileArmorPenetration",
        "missileSpeed",
        "missileRange",
        "targetMovePerTurn",
        "missileLaunchesPerTurn",
        "pdsFamily",
        "pdsPowerCost",
        "pdsReactionCapacity",
        "pdsInterceptionChance",
        "pdsAmmunition",
        "pdsUnlimitedAmmunition",
        "sensorTrackGateEnabled",
        "passiveFirmRange",
        "activeFirmRangeAtOnePower",
        "activeFirmRangeAtTwoPower",
        "sensorPower",
        "ecmPower",
        "eccmPower",
        "shieldHardenerPower",
        "tacticalShieldRechargePower",
        "shieldBatteryCharges",
        "shieldBatteryRestore"
      ],
      "properties": {
        "family": { "enum": ["kinetic", "energy", "missile"] },
        "doctrine": { "type": "string", "minLength": 1 },
        "accuracy": { "type": "integer" },
        "computerBonus": { "type": "integer", "minimum": 0 },
        "evasive": { "type": "boolean" },
        "reactorOutput": { "type": "integer", "minimum": 0 },
        "ammunition": { "type": "integer", "minimum": 0 },
        "missileGuidance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "missileDamage": { "type": "integer", "minimum": 0 },
        "missileShieldPenetration": { "type": "integer", "minimum": 0 },
        "missileArmorPenetration": { "type": "integer", "minimum": 0 },
        "missileSpeed": { "type": "integer", "minimum": 0 },
        "missileRange": { "type": "integer", "minimum": 0 },
        "targetMovePerTurn": { "type": "integer", "minimum": 0 },
        "missileLaunchesPerTurn": { "type": "integer", "minimum": 1 },
        "pdsFamily": { "enum": ["none", "kinetic", "amm", "energy"] },
        "pdsPowerCost": { "type": "integer", "minimum": 0 },
        "pdsReactionCapacity": { "type": "integer", "minimum": 0 },
        "pdsInterceptionChance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "pdsAmmunition": { "type": "integer", "minimum": 0 },
        "pdsUnlimitedAmmunition": { "type": "boolean" },
        "sensorTrackGateEnabled": { "type": "boolean" },
        "passiveFirmRange": { "type": "integer", "minimum": 0 },
        "activeFirmRangeAtOnePower": { "type": "integer", "minimum": 0 },
        "activeFirmRangeAtTwoPower": { "type": "integer", "minimum": 0 },
        "sensorPower": { "type": "integer", "minimum": 0, "maximum": 2 },
        "ecmPower": { "type": "integer", "minimum": 0, "maximum": 1 },
        "eccmPower": { "type": "integer", "minimum": 0, "maximum": 1 },
        "shieldHardenerPower": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "tacticalShieldRechargePower": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "shieldBatteryCharges": { "type": "integer", "minimum": 0 },
        "shieldBatteryRestore": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
