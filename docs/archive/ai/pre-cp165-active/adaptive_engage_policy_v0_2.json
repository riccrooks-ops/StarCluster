  "informationParity": {
    "ownCapabilitiesAllowed": true,
    "ownPowerAndStrainAllowed": true,
    "observedTrackQualityAllowed": true,
    "observedEnemyAttacksAllowed": true,
    "observedEnemyEmissionsAllowed": true,
    "observedEnemyMovementAllowed": true,
    "hiddenOpponentTechnologyLevelsAllowed": false,
    "hiddenOpponentEcmEccmRatingsAllowed": false,
    "internalJammingMarginAllowed": false,
    "undisclosedOpponentComponentsAllowed": false,
    "futureRandomOutcomesAllowed": false,
    "retroactiveDecisionChangesAllowed": false
  },
  "encounter": {
    "initialMapRadius": 5,
    "oppositeEdgeStartingRange": 10,
    "preContactSearch": "one_hex_toward_map_center",
    "preContactTargetCoordinateAvailableToPolicy": false,
    "contactDoesNotImplyFirmTrack": true
  },
  "movement": {
