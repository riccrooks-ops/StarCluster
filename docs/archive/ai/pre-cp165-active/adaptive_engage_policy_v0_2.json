    "opponentNominalWeaponFamilyRangeUsed": false,
    "ownInstalledWeaponReachMayBoundInitialApproach": true,
    "failedFirmAtRangeDrivesLaterClosure": true,
    "rangeZeroClosureAllowed": true
  },
  "combatBlackboard": {
    "targetSpecific": true,
    "contactTurn": true,
    "lastTrackQualityAndRange": true,
    "closestFailedFirmRange": true,
    "maximumOwnObservedAttackRange": true,
    "maximumObservedOpponentAttackRange": true,
    "observableEcmAndActiveSensorEmissions": true,
    "overloadFailuresByRangeAndObservableState": true,
    "safeStrainExhaustionRemembered": true,
    "safeStrainExhaustionIsOwnCapabilityState": true
  },
  "escalation": {
    "ordinaryMovementBeforeOverload": true,
    "ordinaryEccmBeforeOverload": true,
    "sameHexBurnThroughBeforeLastDitchSensorOverloadWhenReachable": true,
    "preferredOverloadOrder": [
      "eccm_overload",
      "active_sensor_overload"
    ],
    "activeSensorOverloadIsLastDitch": true,
    "activeSensorOverloadActsAsEccm": false,
    "failedOverloadSameOrFartherRetryWithoutStateChange": false,
    "failedOverloadCloserRetryAllowed": true,
    "failedOverloadSameRangeRetryAfterMaterialObservableStateChangeAllowed": true,
    "safeStrainExhaustionSuppressesRetry": true,
    "closerRangeDoesNotRestoreSafeStrain": true,
    "observableEnemyStateChangeDoesNotRestoreSafeStrain": true,
    "powerDeniedRetryMayReenterAfterOwnPowerStateChange": true,
    "futureExplicitStrainRecoveryMayRestoreEligibility": true
