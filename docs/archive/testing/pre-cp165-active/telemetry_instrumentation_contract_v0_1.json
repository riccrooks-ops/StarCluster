{
  "schemaVersion": "star-cluster-telemetry-instrumentation-contract-v0.1",
  "checkpoint": 124,
  "status": "blocking_acceptance_contract_for_large_study_readiness",
  "principles": [
    "Raw counters/quantities are authoritative; derived rates must be reconstructible.",
    "Telemetry ownership is explicit so attacker-side and target-side counters are not conflated.",
    "Variant/build metadata carries TL, component composition, Space, power, payload family, and movement order separately from event counters.",
    "Zero-valued telemetry is valid when a mechanic is not exercised; blocking probes prove the supported paths before larger studies.",
    "Internal critical/subsystem damage and missile range-exhaustion are outside the current Python ecology consumer and must not be inferred from these fields."
  ],
