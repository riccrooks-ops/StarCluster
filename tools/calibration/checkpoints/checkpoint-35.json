{
  "schemaVersion": 1,
  "checkpointId": "35",
  "title": "Scripted Relative-Range Changes, Sensor Reacquisition, and Missile Range-Budget Calibration",
  "sdkVersion": "8.0.423",
  "configuration": "Debug",
  "calibrationSolution": "StarCluster.Calibration.sln",
  "testProject": "tests/StarCluster.Tests/StarCluster.Tests.csproj",
  "runnerProject": "src/StarCluster.ScenarioRunner/StarCluster.ScenarioRunner.csproj",
  "manifestFile": "CHECKPOINT_35_SHA256SUMS.txt",
  "outputRoot": "out/checkpoint-35",
  "defaultTrials": 10000,
  "defaultJobs": 24,
  "documentation": [
    "docs/Star_Cluster_Game_Concept_v0.4g.docx",
